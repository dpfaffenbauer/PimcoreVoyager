# Environment Variables Template
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git!

# Pimcore Backend
PIMCORE_API_URL=https://your-pimcore-instance.com/api
PIMCORE_API_KEY=your-api-key

# OAuth2 (if using OAuth authentication)
PIMCORE_OAUTH_CLIENT_ID=your-oauth-client-id
PIMCORE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Environment
NODE_ENV=development

# Optional: Analytics
# ANALYTICS_ID=your-analytics-id

# Optional: Sentry Error Tracking
# SENTRY_DSN=your-sentry-dsn
